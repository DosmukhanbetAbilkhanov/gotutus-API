# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env on production server
# Replace all <PLACEHOLDERS> with actual values
# ============================================

APP_NAME="Tanys"
APP_ENV=production
APP_KEY=<generate-with-php-artisan-key:generate>
APP_DEBUG=false
APP_URL=https://tanys.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================
# LOGGING - Production Settings
# ============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error  # CRITICAL: Only log errors in production
LOG_DAILY_DAYS=14  # Keep logs for 2 weeks

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tanys_production
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# ============================================
# SESSION - API Only (No Sessions Needed)
# ============================================
SESSION_DRIVER=array  # CRITICAL: API doesn't need database sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# CACHE & QUEUE - Use Redis for Performance
# ============================================
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3  # CRITICAL: Use S3 or R2 for file storage
QUEUE_CONNECTION=redis  # CRITICAL: Use Redis for better performance
CACHE_STORE=redis  # CRITICAL: Use Redis for better performance
CACHE_PREFIX=tanys_

# ============================================
# REDIS Configuration
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================
# REVERB (WebSocket Broadcasting)
# ============================================
REVERB_APP_ID=<generate-random-32-chars>
REVERB_APP_KEY=<generate-random-32-chars>
REVERB_APP_SECRET=<generate-random-32-chars>
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https
REVERB_BROADCASTING_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ============================================
# S3 / CloudFlare R2 Configuration
# ============================================
# For CloudFlare R2, use your R2 endpoint as AWS_ENDPOINT
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
AWS_DEFAULT_REGION=auto  # or your region
AWS_BUCKET=tanys-uploads
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://uploads.tanys.app  # Your custom domain for uploads

# ============================================
# MAIL Configuration
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=<your-smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<your-smtp-username>
MAIL_PASSWORD=<your-smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tanys.app
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SMS Provider (for OTP)
# ============================================
SMS_PROVIDER=<your-sms-provider>
SMS_API_KEY=<your-sms-api-key>
SMS_SENDER=Tanys

# ============================================
# FIREBASE Cloud Messaging
# ============================================
FIREBASE_CREDENTIALS=<path-to-firebase-credentials-json>
# Example: /home/forge/tanys.app/storage/firebase-credentials.json

# ============================================
# VITE (Asset Building)
# ============================================
VITE_APP_NAME="${APP_NAME}"

# ============================================
# SECURITY - Certificate Pins for Flutter App
# ============================================
# These are used by Flutter for certificate pinning
# Update when SSL certificate is renewed
CERT_PIN_LEAF=uoFJS+OKCmMnid6B4LKBoIrgmQOxjQKHonSy8/jPGEY=
CERT_PIN_INTERMEDIATE=y7xVm0TVJNahMr2sZydE2jQH8SquXV9yLF9seROHHHU=
CERT_PIN_BACKUP=diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=

# ============================================
# RATE LIMITING
# ============================================
# Adjust these based on your traffic patterns
THROTTLE_LOGIN=5,1  # 5 attempts per minute
THROTTLE_REGISTER=3,1  # 3 attempts per minute
THROTTLE_API=60,1  # 60 requests per minute for general API

# ============================================
# MONITORING & DEBUGGING (Production)
# ============================================
# Set to false or remove in production
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# ============================================
# BACKUP Configuration (Recommended)
# ============================================
BACKUP_DISK=s3
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# ============================================
# INSTRUCTIONS:
# ============================================
# 1. Copy this file: cp .env.production.template .env
# 2. Generate app key: php artisan key:generate
# 3. Generate Reverb keys:
#    php artisan tinker
#    >>> Str::random(32)  // Run 3 times
# 4. Set up Redis: sudo apt-get install redis-server php-redis
# 5. Set up S3/R2 bucket and get credentials
# 6. Run migrations: php artisan migrate --force
# 7. Run seeders: php artisan db:seed --class=LegalDocumentSeeder
# 8. Clear & cache config: php artisan config:clear && php artisan config:cache
# 9. Start Reverb: supervisorctl start reverb
# 10. Start queue workers: supervisorctl start queue
# ============================================
